# kernel-surface-ledger API configuration template.
# Copy this file to .env and fill in your values. NEVER commit .env.
#
# Any OpenAI-compatible chat-completions endpoint works.

# OpenRouter (recommended free option):
KSL_API_BASE=https://openrouter.ai/api/v1
KSL_API_KEY=sk-or-v1-your-key-here
KSL_MODEL=meta-llama/llama-3.3-70b-instruct:free

# OpenAI:
# KSL_API_BASE=https://api.openai.com/v1
# KSL_API_KEY=sk-...
# KSL_MODEL=gpt-4o-mini

# Groq (free tier):
# KSL_API_BASE=https://api.groq.com/openai/v1
# KSL_API_KEY=gsk_...
# KSL_MODEL=llama-3.3-70b-versatile

# Ollama (fully local, no key needed - any non-empty value works):
# KSL_API_BASE=http://localhost:11434/v1
# KSL_API_KEY=ollama
# KSL_MODEL=qwen2.5:7b-instruct
